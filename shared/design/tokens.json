{
  "$comment": "Fuente única del diseño de LibreMusic. No edites Tokens.swift ni Tokens.kt a mano: cambia este archivo y ejecuta `python3 shared/design/gen_tokens.py`. La CI comprueba que estén sincronizados.",

  "brand": {
    "violet": "#8B5CF6",
    "violetDeep": "#5B21B6",
    "magenta": "#EC4899",
    "amber": "#F59E0B",
    "night": "#07070A"
  },

  "artworkFallback": ["#8B5CF6", "#EC4899", "#F59E0B"],

  "themes": {
    "air":   { "name": "Aire",    "blurb": "Plata con Helvetica negra y un anillo de puntos.", "accent": "#111111", "onAccent": "#FFFFFF", "scheme": "light", "font": "default", "maxRadius": 40 },
    "glass": { "name": "Cristal", "blurb": "Luz difusa con los colores de la carátula.",       "accent": "#8B5CF6", "onAccent": "#FFFFFF", "scheme": null,    "font": "default", "maxRadius": 40 },
    "neon":  { "name": "Neón",    "blurb": "Rejilla synthwave que avanza mientras suena.",     "accent": "#FF2BD6", "onAccent": "#FFFFFF", "scheme": "dark",  "font": "rounded", "maxRadius": 40 },
    "plain": { "name": "Sistema", "blurb": "Sin efectos ni fondos animados.",                    "accent": "#8B5CF6", "onAccent": "#FFFFFF", "scheme": null,    "font": "default", "maxRadius": 40 }
  },
  "themeOrder": ["glass", "air", "neon", "plain"],
  "defaultTheme": "glass",

  "radius": {
    "row": 14,
    "card": 16,
    "artworkSmall": 12,
    "artworkCard": 16,
