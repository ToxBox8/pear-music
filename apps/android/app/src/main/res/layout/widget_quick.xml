<?xml version="1.0" encoding="utf-8"?>
<!-- Accesos rápidos (4×1): mezclar favoritas, descargadas, Descubrir y Buscar (los mismos atajos que el icono). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/quick_favorites"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Favoritas"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_shortcut_shuffle" />

        <TextView
            android:id="@+id/quick_favorites_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="Favoritas"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/quick_downloads"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Descargadas"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_shortcut_download" />

        <TextView
            android:id="@+id/quick_downloads_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="Descargadas"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/quick_discover"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Descubrir"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_shortcut_discover" />

        <TextView
            android:id="@+id/quick_discover_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="Descubrir"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/quick_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="Buscar"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_shortcut_search" />

        <TextView
            android:id="@+id/quick_search_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:text="Buscar"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
