<?xml version="1.0" encoding="utf-8"?>
<!-- Copia de seguridad de Google (Android 8–11). Se copian la biblioteca y los ajustes; no los borradores de
     soporte (llevan el correo), el visitorData de YouTube ni las canciones descargadas. -->
<full-backup-content>
    <exclude domain="file" path="support/" />
    <exclude domain="file" path="downloads/" />
    <exclude domain="sharedpref" path="youtube.xml" />
</full-backup-content>
